# Copy this file to .env and fill in your own values.
# Never commit .env or paste your real key into chat.

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for categorization/summarization.
# claude-haiku-4-5-20251001 (fast/cheap, default) or claude-sonnet-5 (higher quality)
ANALYSIS_MODEL=claude-haiku-4-5-20251001

# Whisper model size: tiny, base, small, medium (bigger = slower + more accurate)
WHISPER_MODEL=base

# How many months old a saved video with a promo code / dated offer
# needs to be before it's flagged "verify before use"
STALE_THRESHOLD_MONTHS=3

# Delete the downloaded video file after processing (keep thumbnail + transcript)
DELETE_VIDEO_AFTER_PROCESS=true

# Research agent (videos you share to your Telegram bot). claude-sonnet-5 is the
# default (~$0.10/video); claude-opus-5 researches more deeply at ~2.5x the cost.
AGENT_MODEL=claude-sonnet-5

# Optional: a GitHub token (no scopes needed) raises the GitHub API limit from
# 60 to 5,000 lookups/hour for repo videos.
GITHUB_TOKEN=

# Where "Open full report" links in Telegram point. Change this if you open the
# dashboard from your phone (e.g. via Tailscale) or host it in the cloud.
PUBLIC_BASE_URL=http://127.0.0.1:8787
