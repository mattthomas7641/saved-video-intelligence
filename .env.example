# Copy this file to .env and fill in your own values.
# Never commit .env or paste your real key into chat.

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for categorization/summarization.
# claude-haiku-4-5-20251001 (fast/cheap, default) or claude-sonnet-5 (higher quality)
ANALYSIS_MODEL=claude-haiku-4-5-20251001

# Whisper model size: tiny, base, small, medium (bigger = slower + more accurate)
WHISPER_MODEL=base

# How many months old a saved video with a promo code / dated offer
# needs to be before it's flagged "verify before use"
STALE_THRESHOLD_MONTHS=3

# Delete the downloaded video file after processing (keep thumbnail + transcript)
DELETE_VIDEO_AFTER_PROCESS=true
