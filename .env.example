# Optional overrides. Copy to .env if you want to change any of these; API keys
# are entered on the Settings page (stored in data/secrets.json), not here.
# Never commit .env.

# Who watches and researches what you send: gemini (default: watches the video
# itself, Google Search free up to 5,000/month, ~$0.03-0.06/item), xai (Grok)
# or anthropic (Claude).
AGENT_PROVIDER=gemini
AGENT_MODEL_GEMINI=gemini-3.8-flash
ANALYSIS_MODEL_GEMINI=gemini-3.8-flash
AGENT_MODEL_XAI=grok-4.3
ANALYSIS_MODEL_XAI=grok-4.3
AGENT_MODEL=claude-sonnet-5

# Your project folders, judged against tech content (read-only; secrets, data and
# .env files are never read). Defaults to ~/Projects.
PROJECTS_DIR=

# Where "Full report" links in notifications point. Set this to your Tailscale
# address (https://<machine>.<tailnet>.ts.net) to open reports from your phone;
# that host is also allowed by the request guard.
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Timezone for dates on the page and the daily spending cap.
APP_TIMEZONE=America/New_York

# Optional: a GitHub token (no scopes needed) raises the GitHub API limit from
# 60 to 5,000 lookups/hour for repo videos.
GITHUB_TOKEN=

# Delete downloaded video files once they've been watched.
DELETE_VIDEO_AFTER_PROCESS=true

# Only used by non-Gemini providers (Whisper speech-to-text size) and the archive.
WHISPER_MODEL=base
ANALYSIS_MODEL=claude-haiku-4-5-20251001
STALE_THRESHOLD_MONTHS=3
